NODE_ENV=development
PORT=5001
APP_NAME=Aegis 3.0 API (TEST)
LOG_LEVEL=debug

# Security
JWT_SECRET=test-jwt-secret-for-local-development-only

# Database — SEPARATE test database (local MongoDB or Atlas free tier)
# Option A: Local MongoDB
MONGO_URI=mongodb://localhost:27017/aegis3_test
# Option B: Atlas free tier (create a separate cluster/database named aegis3_test)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/aegis3_test?retryWrites=true&w=majority

# CORS
CLIENT_URL=http://localhost:5173
ADDITIONAL_ORIGINS=http://localhost:5174,http://localhost:3000

# Google auth (use your existing keys — works with localhost)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com

# Cloudinary (use same keys — uploads go to same bucket but that's fine for testing)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email — disable for testing
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_USER=
EMAIL_PASSWORD=

# Socket adapter — memory for local dev
SOCKET_ADAPTER=memory
