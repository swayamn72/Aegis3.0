# Core runtime
NODE_ENV=production
PORT=5000
APP_NAME=Aegis 3.0 API
LOG_LEVEL=info

# Security
JWT_SECRET=replace-with-a-long-random-secret
BCRYPT_SALT_ROUNDS=12

# Database (AWS DocumentDB or Mongo-compatible URI)
# Include tls=true and replicaSet=rs0 for DocumentDB when applicable.
MONGO_URI=mongodb://username:password@docdb-cluster.cluster-xxxx.ap-south-1.docdb.amazonaws.com:27017/aegis3?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# CORS / frontend origins
CLIENT_URL=https://your-frontend-domain.com
ADDITIONAL_ORIGINS=https://admin.your-frontend-domain.com,https://staging.your-frontend-domain.com

# Google auth
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_CLIENT_IDS=your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Firebase Admin
# Option A: raw JSON string
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Option B: base64-encoded JSON
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64-encoded-service-account-json

# Email (optional)
EMAIL_USER=your-smtp-user
EMAIL_PASSWORD=your-smtp-password
# Optional explicit SMTP config (recommended for AWS SES SMTP)
# SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password
# EMAIL_FROM="Aegis <noreply@yourdomain.com>"
# SMTP_REJECT_UNAUTHORIZED=true
ENABLE_EMAIL_NOTIFICATIONS=false

# Socket adapter / Redis (optional for single instance)
SOCKET_ADAPTER=memory
SOCKET_REDIS_CONNECT_TIMEOUT_MS=5000
# Option A:
# REDIS_URL=redis://default:password@your-elasticache-endpoint:6379
# Option B:
# REDIS_HOST=your-elasticache-endpoint
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# AWS SDK (only if you call AWS APIs directly from server without IAM role)
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
